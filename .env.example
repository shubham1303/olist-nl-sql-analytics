# Copy to .env and replace every "change-me" value. .env is git-ignored.
# Used by docker-compose.yml and by `python -m olist_nlsql.dbsetup`.

# Superuser for the local container (bootstrap only: creates roles and grants).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
# Use 127.0.0.1, not localhost: the port is bound to IPv4 loopback only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# olist_owner: owns the raw and analytics schemas; runs migrations and loads.
NLSQL_OWNER_PASSWORD=change-me

# analytics_reader: the read-only role the application uses (ADR 0002).
NLSQL_READER_PASSWORD=change-me
