# Copy to .env and replace every "change-me" value. .env is git-ignored.
# Used by docker-compose.yml and by `python -m olist_nlsql.dbsetup`.

# Superuser for the local container (bootstrap only: creates roles and grants).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
# Use 127.0.0.1, not localhost: the port is bound to IPv4 loopback only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# olist_owner: owns the raw and analytics schemas; runs migrations and loads.
NLSQL_OWNER_PASSWORD=change-me

# analytics_reader: the read-only role the application uses (ADR 0002).
NLSQL_READER_PASSWORD=change-me

# Local API (python -m olist_nlsql.api serve): SHA-256 of the shared access code
# (ADR 0004). Create it with: python -m olist_nlsql.api hash-code
# NLSQL_ACCESS_CODE_SHA256=<64 hex characters>

# Deployed API (optional): the access code for `evaluation run --api-url` and the eval
# workflow. Its hash goes in infra/main/terraform.tfvars, never the code itself.
# NLSQL_API_ACCESS_CODE=<code>

# AWS deployment (optional): paste `terraform -chdir=infra/main output -raw env` here
# for `dbsetup aws-build` and the live Data API tests. The values contain the account ID.
# NLSQL_DB_CLUSTER_ARN=...
# NLSQL_DB_MASTER_SECRET_ARN=...
# NLSQL_DB_OWNER_SECRET_ARN=...
# NLSQL_DB_SECRET_ARN=...
# NLSQL_DATA_BUCKET=...
# NLSQL_DB_NAME=olist
